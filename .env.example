# Copy to .env.local for local work. On Railway, add each of these under Variables.
# NEXT_PUBLIC_* values are baked in at BUILD time: change one, then redeploy.

# ---- Server only (runtime). Never prefix these with NEXT_PUBLIC_. ----
# Supabase transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Shared with the Supabase Database Webhook (header x-webhook-secret)
CRM_WEBHOOK_SECRET=
# Sent by the Railway cron service as header x-cron-secret
CRON_SECRET=
# Cloudflare Turnstile secret
TURNSTILE_SECRET_KEY=
# Meta Conversions API
META_CAPI_TOKEN=
# Optional: Events Manager test code while testing
META_TEST_EVENT_CODE=
# Railway sets PORT itself; npm start listens on it.

# ---- Public (browser, needed at build time) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Set to "false" to turn off the homepage loading screen.
NEXT_PUBLIC_ENABLE_INTRO=true
